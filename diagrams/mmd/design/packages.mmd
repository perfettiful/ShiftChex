    persistence["<b>persistence</b><br/>SqliteRepository, db.js<br/>migrations/*.sql, seed.js"]
    scripts["<b>scripts</b><br/>db.js, diagrams.js"]
    db[("data/shiftchex.db")]

    ui -. "«use»" .-> application
    application -. "«use»" .-> domain
    application -. "«use» (wiring only)" .-> persistence
