---
title: Design Class Diagram (Elaboration 2)
config:
  layout: elk
---
%% the application layer. every system operation from the SSDs lands on one
%% of the five controllers, and only the repository ever sees SQL.
%% a periodId that's left out means the week being worked on (the first draft)
classDiagram
    direction TB
    class ScheduleController {
        <<Controller>>
        +validate(periodId) Result
        +assign(shiftId, employeeId, overrideReason) Result
        +publish(periodId) Result
        +unpublish(periodId) Result
        +decideTimeOff(requestId, decision) Result
        +projectedCost(periodId) number
    }
    class SwapController {
        <<Controller>>
        +board(employeeId) Entry[]
        +post(shiftId, employeeId) Result
        +withdraw(swapId, employeeId) Result
        +claim(swapId, employeeId) Result
        +pending() Entry[]
        +decide(swapId, decision) Result
    }
    class AvailabilityController {
        <<Controller>>
        +declare(employeeId, input) Result
        +requestTimeOff(employeeId, input) Result
        +cancelTimeOff(employeeId, requestId) Result
    }
    class ReportController {
        <<Controller>>
        +coverage(periodId) Report
    }
    class SessionController {
        <<Controller>>
        +login(username, password) Result
        +logout(token) Result
        +authorizeToken(token, need) Check
        +stateFor(user, periodId) State
        +resetDemo() Result
    }
    class RuleEngine {
        <<Pure Fabrication>>
        -root Rule
        +validate(period, repo) Result
        +validateAssignment(shift, employeeId, period, repo) Result
    }
    class RuleFactory {
        +rulesFor()$ Rule
    }
    class Rule {
        <<interface>>
        +id
        +check(ctx) Violation[]
    }
    class EventBus {
        +on(name, handler)
        +emit(name, payload)
    }
    class SqliteRepository {
        <<Adapter>>
        +periods() SchedulePeriod[]
        +period(id) SchedulePeriod
        +periodOfShift(shiftId) SchedulePeriod
        +shiftsBetween(from, to) Shift[]
        +employees() Employee[]
        +swaps() SwapRequest[]
        +saveShift(shift)
        +savePeriod(period)
        +addSwap(swap)
        +saveSwap(swap)
        +addNotice(notice)
        +addAudit(entry)
        +transaction(fn)
    }
    class Violation {
        +ruleId
        +severity
        +message
        +shiftId
        +employeeId
        +blocks() boolean
    }

    SessionController --> ScheduleController
    SessionController --> SwapController
    SessionController --> SqliteRepository
    ScheduleController --> RuleEngine
    SwapController --> RuleEngine
    ScheduleController --> EventBus
    SwapController --> EventBus
    ScheduleController --> SqliteRepository
    SwapController --> SqliteRepository
    AvailabilityController --> SqliteRepository
    ReportController --> SqliteRepository
    RuleEngine --> "1" Rule : root
    RuleFactory ..> Rule : «create»
    Rule ..> Violation : «create»
