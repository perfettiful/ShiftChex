title: "Communication Diagram: Claim Posted Shift (UC-05)"
---
%% same messages as the claim sequence diagram, laid out by who talks to who.
%% numbers give the order, [ ] is the condition
flowchart LR
    E["«actor»<br/><b>Employee</b>"]:::actor
    SW[":SwapController"]
    RE[":RuleEngine"]
    Repo[":SqliteRepository"]
    SR[":SwapRequest"]
    Sh[":Shift"]

    E -- "1: claim(swapId, employeeId)" --> SW
    SW -- "1.1: swaps(), periodOfShift(shiftId)<br/>1.5 [passes]: transaction(saveSwap, saveShift)" --> Repo
    SW -- "1.2: validateAssignment(shift, employeeId)" --> RE
    SW -- "1.3 [passes]: claimedBy, status = claimed" --> SR
    SW -- "1.4 [passes]: status = claimed" --> Sh

    classDef actor fill:#ffffff,stroke:#3a3a3a,stroke-width:1.6px
