---
title: "Sequence: Validate Schedule (UC-07)"
---
sequenceDiagram
    actor Manager
    participant SC as :ScheduleController
    participant Repo as :SqliteRepository
    participant RE as :RuleEngine
    participant Root as all :CompositeRule
    participant R as :Rule
    Manager->>SC: validate()
    SC->>Repo: currentPeriod()
    Repo-->>SC: period with its shifts
    SC->>+RE: validate(period, repo)
    RE->>Repo: employeesById(), rolesById(), settings()
    RE->>+Root: check(ctx)
    loop each rule, 11 in all
        Root->>R: check(ctx)
        R-->>Root: violations
    end
    Root-->>-RE: all violations
    RE-->>-SC: blocking and warnings
    SC-->>Manager: violations grouped by shift
