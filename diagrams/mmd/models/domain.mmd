---
title: Domain Model (Elaboration 2)
config:
  layout: dagre
---
%% conceptual classes only, so no methods and no arrowheads.
%% elab 2 change: certifications got their own concepts (CertType, Certificate)
%% instead of one expiry date on Qualification, and Notice was added
classDiagram
    direction LR

    class SchedulePeriod {
        startDate
        endDate
        status
        budget
    }
    class Shift {
        date
        startTime
        endTime
        status
        overrideReason
    }
    class SwapRequest {
        postedOn
        status
        decidedOn
    }
    class Employee {
        name
        dateOfBirth
        hireDate
    }
    class Availability {
        weekday
        startTime
        endTime
        effectiveFrom
    }
    class TimeOffRequest {
        startDate
        endDate
        reason
        status
    }
    class Qualification {
        hourlyRate
    }
    class Role {
        name
    }
    class Certificate {
        issuedOn
        expiresOn
    }
    class CertType {
        name
        graceDays
        renewYears
    }
    class Notice {
        text
        sentOn
    }

    SchedulePeriod "1" -- "*" Shift : contains
    Shift "*" -- "0..1" Employee : assigned to
    Shift "*" -- "1" Role : needs
    Shift "1" -- "0..*" SwapRequest : traded through
    SwapRequest "*" -- "1..2" Employee : posted / claimed by
    Employee "1" -- "*" Availability : declares
    Employee "1" -- "*" TimeOffRequest : asks for
    Employee "1" -- "1..*" Qualification : trained as
    Qualification "*" -- "1" Role : for
    Employee "1" -- "*" Certificate : holds
    Certificate "*" -- "1" CertType : is a
    Role "*" -- "*" CertType : requires
    Employee "1" -- "*" Notice : receives
