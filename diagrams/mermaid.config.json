{
  "theme": "base",
  "look": "classic",
  "layout": "dagre",
  "fontFamily": "Helvetica, Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#eef2f8",
    "primaryTextColor": "#1a1a1a",
    "primaryBorderColor": "#3a3a3a",
    "secondaryColor": "#ffffff",
    "secondaryTextColor": "#1a1a1a",
    "secondaryBorderColor": "#3a3a3a",
    "tertiaryColor": "#ffffff",
    "tertiaryTextColor": "#1a1a1a",
    "tertiaryBorderColor": "#3a3a3a",
    "lineColor": "#3a3a3a",
    "textColor": "#1a1a1a",
    "mainBkg": "#eef2f8",
    "nodeBorder": "#3a3a3a",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#3a3a3a",
    "titleColor": "#1a1a1a",
    "edgeLabelBackground": "#ffffff",
    "noteBkgColor": "#f7f8fa",
    "noteBorderColor": "#9aa3ae",
    "noteTextColor": "#3a3a3a",
    "actorBkg": "#eef2f8",
    "actorBorder": "#3a3a3a",
    "actorTextColor": "#1a1a1a",
    "actorLineColor": "#5a6472",
    "signalColor": "#3a3a3a",
    "signalTextColor": "#1a1a1a",
    "labelBoxBkgColor": "#eef2f8",
    "labelBoxBorderColor": "#3a3a3a",
    "labelTextColor": "#1a1a1a",
    "loopTextColor": "#5a6472",
    "activationBkgColor": "#eef2f8",
    "activationBorderColor": "#3a3a3a",
    "sequenceNumberColor": "#ffffff",
    "classText": "#1a1a1a",
    "attributeBackgroundColorOdd": "#ffffff",
    "attributeBackgroundColorEven": "#f6f8fb",
    "relationColor": "#3a3a3a",
    "relationLabelColor": "#5a6472",
    "stateBkg": "#eef2f8",
    "stateBorder": "#3a3a3a",
    "transitionColor": "#3a3a3a",
    "transitionLabelColor": "#5a6472",
    "compositeBackground": "#ffffff",
    "compositeTitleBackground": "#eef2f8",
    "altBackground": "#f6f8fb",
    "stateLabelColor": "#1a1a1a",
    "labelColor": "#1a1a1a",
    "specialStateColor": "#1a1a1a",
    "innerEndBackground": "#1a1a1a"
  },
  "flowchart": {
    "curve": "linear",
    "padding": 12,
    "nodeSpacing": 30,
    "rankSpacing": 42,
    "htmlLabels": true,
    "useMaxWidth": false
  },
  "class": {
    "padding": 8,
    "hideEmptyMembersBox": true,
    "useMaxWidth": false
  },
  "sequence": {
    "actorMargin": 50,
    "boxMargin": 12,
    "messageMargin": 30,
    "mirrorActors": true,
    "noteMargin": 10,
    "messageFontSize": 14,
    "actorFontSize": 15,
    "noteFontSize": 13,
    "showSequenceNumbers": false,
    "wrap": false,
    "width": 110,
    "boxTextMargin": 8,
    "diagramMarginX": 20,
    "diagramMarginY": 20,
    "useMaxWidth": false,
    "bottomMarginAdj": 1,
    "height": 65
  },
  "er": {
    "layoutDirection": "LR",
    "entityPadding": 10,
    "minEntityWidth": 120,
    "fontSize": 14,
    "useMaxWidth": false
  },
  "state": {
    "padding": 8,
    "useMaxWidth": false
  },
  "elk": {
    "mergeEdges": false,
    "nodePlacementStrategy": "NETWORK_SIMPLEX"
  },
  "classDiagram": {
    "hideEmptyMembersBox": true
  }
}
