flowchart TB
    subgraph ui
        ScheduleBuilderView
        EmployeePortalView
        ReportView
    end
    subgraph application
        ScheduleController
        SwapController
        RuleEngine
    end
    subgraph domain
        D1["Employee, Role, Qualification"]
        D2["Shift, SchedulePeriod"]
        D3["SwapRequest, Violation"]
