---
title: Data Model - ShiftChex
---
%% the tables from 001_create_tables.sql. organization, setting, id_counter and
%% audit_entry are left off since nothing points at them
erDiagram
    schedule_period ||--o{ shift : has
    shift ||--o{ shift_duty : has
    shift ||--o{ swap_request : "posted as"
    role ||--o{ shift : for
    employee |o--o{ shift : works
    employee ||--o{ swap_request : "posts / claims"
    employee ||--o{ qualification : "trained as"
    role ||--o{ qualification : pays
    role ||--o{ role_cert : needs
    cert_type ||--o{ role_cert : "required by"
    employee ||--o{ certificate : holds
    cert_type ||--o{ certificate : "type of"
    employee ||--o{ availability : declares
    employee ||--o{ time_off_request : "asks for"
    employee ||--o{ notice : gets

    employee {
        text id PK
        text name
        text date_of_birth
        text hire_date
        text status
        real max_hours_preference
    }
    role {
        text id PK
        text name
    }
    cert_type {
        text id PK
        text name
        int grace_days
        int renew_years
    }
    role_cert {
        text role_id PK, FK
        text cert_type_id PK, FK
        text only_if
    }
    qualification {
        text employee_id PK, FK
        text role_id PK, FK
        real hourly_rate
    }
    certificate {
        int id PK
        text employee_id FK
        text cert_type_id FK
        text issued_on
        text expires_on
    }
    availability {
        int id PK
        text employee_id FK
        int weekday
        text start_time
        text end_time
        text effective_from
    }
    time_off_request {
        text id PK
        text employee_id FK
        text start_date
        text end_date
        text reason
        text status
    }
    schedule_period {
        text id PK
        text start_date
        text end_date
        text status
        real budget
        text published_on
    }
    shift {
        text id PK
        text period_id FK
        text role_id FK
        text employee_id FK
        text date
        text start_time
        text end_time
        int required
        text status
        text override_reason
    }
    shift_duty {
        text shift_id PK, FK
        text duty PK
    }
    swap_request {
        text id PK
        text shift_id FK
        text posted_by FK
        text claimed_by FK
        text status
        text posted_on
        text decided_on
        text note
    }
    notice {
        text id PK
        text employee_id FK
        text text
    }
