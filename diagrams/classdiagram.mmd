---
title: Design Class Diagram - Elaboration 1
---
classDiagram
    direction TB
    class ScheduleController {
        +buildDraft(periodId)
        +assign(shiftId, empId)
        +validate(periodId)
        +publish(periodId)
        +decideTimeOff(requestId, decision)
    }
    class AvailabilityController {
        +declare(employeeId, effectiveFrom, slots)
        +requestTimeOff(employeeId, startDate, endDate, reason)
    }
    class Employee {
        -name
        -dateOfBirth
        +availabilityOn(date)
        +isAvailableOn(date, start, end)
        +hasApprovedTimeOffOn(date)
    }
    class TimeOffRequest {
        -startDate
        -endDate
        -status
        +overlaps(startDate, endDate)
    }
    class SchedulePeriod {
        -status
        -budget
        +addShift(s)
        +shifts()
        +projectedCost()
    }
    class RuleEngine {
        -rules Rule[]
        +validate(period)
        +validateAssignment(shift, emp)
    }
    class Violation {
        -severity
        -message
        -shiftRef
    }
    class Shift {
        -date
        -startTime
        -status
        +assign(emp)
        +isCovered()
    }
    class Rule {
        <<interface>>
        +check(ctx) Violation[]
    }
    class AvailabilityRule
    AvailabilityRule : +check(ctx)
    class RestRule
    RestRule : +check(ctx)
    class QualificationRule
    QualificationRule : +check(ctx)
    class OvertimeRule
    OvertimeRule : +check(ctx)
    class CoverageRule
    CoverageRule : +check(ctx)

    ScheduleController --> RuleEngine : uses
    ScheduleController --> SchedulePeriod : manages
    AvailabilityController --> Employee : updates
    AvailabilityController ..> TimeOffRequest : creates
    Employee "1" --> "*" TimeOffRequest : has
    SchedulePeriod "1" --> "*" Shift : contains
    RuleEngine "1" --> "*" Rule : holds
    RuleEngine ..> Violation : creates

    %% implementing an interface is a dashed line with a hollow triangle.
    %% the old PNG had these solid, which actually means inheritance
    Rule <|.. AvailabilityRule
    Rule <|.. RestRule
    Rule <|.. QualificationRule
    Rule <|.. OvertimeRule
    Rule <|.. CoverageRule
